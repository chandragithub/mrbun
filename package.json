{
  "name": "mr-bun",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/sync-android.js",
    "build:web": "tsc -b && vite build",
    "build:android": "npm run build && cap sync android",
    "sync:android": "node scripts/sync-android.js && cap sync android",
    "open:android": "cap open android",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "deploy:worker": "wrangler deploy",
    "deploy:pages": "wrangler pages deploy dist",
    "d1:init": "wrangler d1 execute mrbun --remote --file=./schema.sql",
    "d1:local": "wrangler d1 execute mrbun --local --file=./schema.sql"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.6",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "wrangler": "^3.114.17"
  }
}
